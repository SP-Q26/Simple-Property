# STRIPE_LIVE_E2E_COUPON_ID=
# Stripe Dashboard → Settings → Billing → Customer portal (enable for subscriptions)

# Phase 3 · Vercel Storage → Upstash Redis (app reads only these two)
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...
# Upstash may also inject KV_URL, REDIS_URL, KV_REST_API_READ_ONLY_TOKEN · safe to delete in Vercel if unused.

# Phase 3 · Resend (magic link + deadline reminders + feedback)
# RESEND_API_KEY=re_...
# SPT_EMAIL_FROM=Deposit Desk <hello@simple-property.com>
# SPT_FEEDBACK_TO=hello@simple-property.com

# Phase 3 · Vercel Cron auth (auto-set as CRON_SECRET on Vercel; set locally for manual cron test)
# SPT_CRON_SECRET=random-cron-secret
