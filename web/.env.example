# Stripe test mode · card 4242 4242 4242 4242
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional · Dashboard price IDs (inline price_data fallback if unset)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# HMAC for /api/entitlement + magic links (32+ random bytes)
SPT_ENTITLEMENT_SECRET=generate-32-plus-random-bytes-here
# Preview checkout success/cancel override (production uses catalog default)
# SPT_SITE_URL=https://your-preview.vercel.app
# Stripe Dashboard → Settings → Billing → Customer portal (enable for subscriptions)

# Phase 3 · Vercel → Storage → Upstash Redis (sets KV_REST_API_URL + KV_REST_API_TOKEN)
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...

# Phase 3 · Resend (magic link + deadline reminders)
# RESEND_API_KEY=re_...
# SPT_EMAIL_FROM=Deposit Desk <hello@simpleproperty.tools>

# Phase 3 · Vercel Cron auth (auto-set as CRON_SECRET on Vercel; set locally for manual cron test)
# SPT_CRON_SECRET=random-cron-secret
