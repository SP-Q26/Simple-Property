{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.simpleproperty.tools"
        }
      ],
      "destination": "https://simpleproperty.tools/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/logs",
      "destination": "/logs.html"
    },
    {
      "source": "/success",
      "destination": "/success.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/launch-stack",
      "destination": "/launch-stack.html"
    },
    {
      "source": "/spt-ai-bus.json",
      "destination": "/spt-ai-bus.json"
    },
    {
      "source": "/.well-known/spt-gospel.json",
      "destination": "/.well-known/spt-gospel.json"
    },
    {
      "source": "/.well-known/ai-discovery.json",
      "destination": "/.well-known/ai-discovery.json"
