{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.simple-property.com"
        }
      ],
      "destination": "https://simple-property.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog/missed-deposit-deadline-midwest-small-landlord",
      "destination": "/blog/missed-deposit-deadline-small-landlord-multi-state",
      "permanent": true
    },
    {
